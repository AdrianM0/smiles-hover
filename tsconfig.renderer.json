// The output renderer runs in a webview, not in Node: DOM types, no vscode.
// esbuild does the bundling; this exists to type-check it.
{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true
  },
  "include": ["src/output-renderer.ts"]
}
