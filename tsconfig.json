{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true
  },
  // The output renderer is webview code — DOM types, bundled separately.
  // See tsconfig.renderer.json.
  "exclude": ["node_modules", ".vscode-test", "src/output-renderer.ts"]
}
